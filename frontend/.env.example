# Leave everything blank to use the self-hosted LiveKit server from the compose files
# (ws://localhost:7880 with the dev-mode devkey / secret credentials).

# Development token server ID from your project's Settings page in LiveKit Cloud.
# https://docs.livekit.io/frontends/build/authentication/development-token-server/
LIVEKIT_TOKEN_SERVER_ID=

# Otherwise LiveKit credentials for the included token endpoint (app/api/token/route.ts).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Name the worker registers with; defaults to chattr.
AGENT_NAME=
