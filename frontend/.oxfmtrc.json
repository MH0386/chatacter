{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "dist/",
    "docs/",
    "node_modules/",
    "pnpm-lock.yaml",
    ".next/",
    ".env*"
  ],
  "printWidth": 100,
  "semi": true,
  "sortImports": {
    "customGroups": [
      {
        "elementNamePattern": [
          "@/**"
        ],
        "groupName": "app"
      },
      {
        "elementNamePattern": [
          "react",
          "react/**",
          "react-*",
          "react-*/**"
        ],
        "groupName": "react"
      },
      {
        "elementNamePattern": [
          "next",
          "next/**",
          "next-*",
          "next-*/**"
        ],
        "groupName": "next"
      },
      {
        "elementNamePattern": [
          "@?*/**"
        ],
        "groupName": "scoped"
      }
    ],
    "groups": [
      "react",
      "next",
      [
        "builtin",
        "external"
      ],
      "scoped",
      [
        "app",
        "internal",
        "subpath"
      ],
      [
        "parent",
        "sibling",
        "index"
      ],
      "style",
      "unknown"
    ],
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "sortTailwindcss": {},
  "tabWidth": 2
}
